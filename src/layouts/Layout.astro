---
interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "Software developer in St. John\'s, Newfoundland. Web 3D, game development, and web development.",
	image = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="FavvyOut.gif" type="image/gif" >
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<!-- discord / slack / imessage / etc. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Ethan Crann" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ethan Crann - CRT test card" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="theme-color" content="#ff1e1e" />
		<link href="/awesome/css/fontawesome.css" rel="stylesheet" />
		<link href="/awesome/css/solid.css" rel="stylesheet" />
		<link href="/awesome/css/brands.css" rel="stylesheet" />
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
		overflow: hidden;
	}
	html {
		font-family: system-ui, sans-serif;
		background: #13151a;
		background-size: 224px;
		margin: 0;
		height: 100%;
	}
	body {
		margin: 0;
		height: 100%;
		width: 100%;
		display: flex;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
</style>
